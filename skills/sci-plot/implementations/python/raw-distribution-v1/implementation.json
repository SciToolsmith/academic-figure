{
  "schema_version": "sciplot.implementation/v1",
  "id": "raw-distribution-v1",
  "version": "1.0.0",
  "status": "verified",
  "backend": {
    "language": "python",
    "entrypoint": "render.py",
    "requires": [
      "Python >= 3.9",
      "matplotlib >= 3.7"
    ]
  },
  "source": {
    "category": "sciplot-native",
    "license": "Apache-2.0",
    "case_influences": [
      {
        "id": "rf-0018",
        "reuse_level": "principle-only",
        "runtime_dependency_on_case_pack": false,
        "borrowed_decisions": [
          "preserve raw observations",
          "keep descriptive summaries visually subordinate to the data"
        ]
      }
    ]
  },
  "semantic_signature": {
    "analysis_unit": "one declared observation",
    "relationship": "grouped distribution",
    "input_structure": "one row per observation",
    "evidence_goal": "show heterogeneity before a descriptive group summary",
    "supported_task_phases": [
      "exploratory",
      "descriptive",
      "presentation"
    ],
    "not_for": [
      "paired or repeated observations",
      "inferential confidence intervals",
      "causal or adjusted effect claims"
    ]
  },
  "input_contract": {
    "required_roles": [
      "observation_id",
      "group",
      "value"
    ],
    "unique_key": [
      "observation_id"
    ],
    "minimum_group_size": 2,
    "nonfinite_policy": "fail",
    "missingness_policy": "fail; exclusions must occur before rendering and be declared in the Figure Contract"
  },
  "guards": [
    "RD-INPUT-01 required columns and nonblank values",
    "RD-KEY-01 globally unique observation identifiers",
    "RD-VALUE-01 finite numeric values",
    "RD-ORDER-01 declared group order exactly covers observed groups",
    "RD-SUMMARY-01 at least two observations per group",
    "RD-DEMO-01 explicit data role, synthetic watermark, and production rejection of semantically equivalent bundled demo content"
  ],
  "cli_contract": {
    "required": [
      "--input",
      "--data-manifest",
      "--output-dir",
      "--run-mode"
    ],
    "production_required": [
      "--figure-contract"
    ],
    "column_bindings": [
      "--observation-col",
      "--group-col",
      "--value-col"
    ],
    "physical_output": [
      "--width-mm",
      "--height-mm",
      "--formats",
      "--dpi"
    ]
  },
  "outputs": {
    "basename": "distribution",
    "formats": [
      "svg",
      "pdf",
      "png"
    ],
    "analysis_table": "analysis-table.csv",
    "data_validation": "data-validation.json",
    "manifest": "distribution.manifest.json",
    "editable_svg_text": true,
    "silent_tight_crop": false
  },
  "verification": {
    "fixture": "examples/demo.csv",
    "fixture_manifest": "examples/demo-data.json",
    "figure_contract": "references/figure-contract.descriptive-distribution.example.json",
    "test_module": "tests/test_native_renderers_v12.py",
    "source_sha256": "04a6d162a6e1575c076472c193bac58133c0fd83470eb7589737e8c076c2ff34",
    "source_files_sha256": {
      "render.py": "04a6d162a6e1575c076472c193bac58133c0fd83470eb7589737e8c076c2ff34"
    },
    "shared_source_files_sha256": {
      "implementations/python/_shared/runtime.py": "bc9ed53c6c64f3cfb87790c094a5d9db6f06cb2390bff0b168e320e11c647d70"
    },
    "local_smoke_status": "passed-svg-pdf-png-2026-08-06",
    "local_smoke_report": "verification/local-smoke.json",
    "test_command": "python -m unittest tests/test_native_renderers_v12.py -v"
  }
}
